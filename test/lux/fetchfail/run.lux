[doc test that a failed fetch of a dependency is an error and leaves nothing behind]

[config timeout=30000]

[macro fetch_fails dep]
    !make EXTRA_DEPS=$dep fetch-deps; echo rc=$$?
    ?rc=2
    ?SH-PROMPT
    -$dep
    !ls -1 deps
    ?SH-PROMPT
    -
[endmacro]

[shell test]
    # a failing patch must remove the fetched dependency, so that it
    # is fetched and patched again the next time
    !make FAIL_PATCH=1 fetch-deps; echo rc=$$?
    ?rc=2
    ?SH-PROMPT
    -foo
    !ls -1 deps
    ?SH-PROMPT
    -

    !make fetch-deps; echo rc=$$?
    ?rc=0
    ?SH-PROMPT
    !ls -1 deps
    ?foo
    ?SH-PROMPT

    [invoke fetch_fails nocp]
    [invoke fetch_fails nogit]
